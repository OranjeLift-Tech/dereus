# Lokale instellingen, sleutels en hulpprogramma's
.env
.env.*
!.env.example
.codex/
.claude/
node_modules/
__pycache__/
*.py[cod]

# Werkstaat van build.py: het slot van de draaiende build en de cache met invoer- en uitvoerhashes.
# Allebei per machine, nooit delen. .lastmod.json blijft wel in git: dat zijn de sitemap-datums.
_werk/.build.lock
_werk/.bouwcache.json

# Gegenereerde concepten en browserprofielen blijven lokaal
_voorbeeld/
website/review/

# Kandidatenreeksen waaruit gekozen wordt. De gekozen beelden staan in img/,
# de rest is tussenmateriaal en samen bijna een halve gigabyte.
beeld-opties/
logo-opties/

# Schermafdrukken van Brocken en De Kievit: de analyses ernaast blijven wel.
# Beide sites staan als repo op deze machine, dus opnieuw maken kan altijd.
website/referentie/*
!website/referentie/*.md
Thumbs.db
Desktop.ini
